{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/venue/layout,_N_T_/venue/page,_N_T_/venue"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/_index",
    "/venue/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 0,
    "slots": {
      "children": {
        "hints": 64,
        "slots": {
          "children": {
            "hints": 160,
            "slots": null
          }
        }
      }
    }
  }
}